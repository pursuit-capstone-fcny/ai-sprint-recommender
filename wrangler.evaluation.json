{
  "name": "ai-sprint-recommender-llm-test",
  "main": "server/evaluation-worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "LLM_ENABLED": "false",
    "LLM_APPROVALS_RECORDED": "true",
    "LLM_ENVIRONMENT": "test",
    "LLM_MODEL": "claude-haiku-5-5",
    "LLM_CATALOG_URL": "https://ai-sprint-recommender-llm-test.jason-zeng151.workers.dev/api/evaluation-catalog/b3f96d7113308d627eeb6c9667ac51a44155210faf515db2ef5a41fb5e9bfae7.json",
    "LLM_MAX_INPUT_TOKENS": "65000",
    "LLM_MAX_OUTPUT_TOKENS": "512",
    "LLM_REQUESTS_PER_MINUTE": "60",
    "LLM_CLIENT_REQUESTS_PER_MINUTE": "60",
    "LLM_MAX_CONCURRENCY": "2",
    "LLM_DAILY_MICRODOLLARS": "3000000",
    "LLM_MONTHLY_MICRODOLLARS": "3000000",
    "LLM_INPUT_MICRODOLLARS_PER_MILLION": "100000",
    "LLM_OUTPUT_MICRODOLLARS_PER_MILLION": "500000",
    "LLM_DIAGNOSTICS_ENABLED": "true",
    "LLM_TEST_EXPIRES_AT": "2026-10-22T00:00:00Z",
    "LLM_PROVIDER": "anthropic",
    "LLM_ALLOWANCE_MICRODOLLARS": "3000000",
    "LLM_PRIOR_MICRODOLLARS": "2164995",
    "LLM_REASONING_EFFORT": "low"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RECOMMENDATION_BUDGET",
        "class_name": "RecommendationBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "recommendation-budget-v1",
      "new_sqlite_classes": ["RecommendationBudget"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
