# Blocks pushes that target main. Refs arrive on stdin as:
# <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Direct pushes to main are blocked. Open a PR (see AGENTS.md)." >&2
      exit 1
      ;;
  esac
done
