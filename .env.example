# Apps Script /exec URL serving the public catalog envelope.
# Use the TEST endpoint locally and in previews. Production uses the FCNY endpoint.
VITE_CATALOG_URL=
# Unset locally: use the shared fictional fixture only if no URL is configured.
# remote: require VITE_CATALOG_URL. fixture: explicit, visibly labeled demo mode.
VITE_CATALOG_SOURCE=
# Logging is off unless all three are explicitly configured for the test copy.
# VITE_USAGE_TEST_URL must equal VITE_CATALOG_URL. Never enable production logging.
VITE_USAGE_ENABLED=false
VITE_USAGE_ENVIRONMENT=
VITE_USAGE_TEST_URL=

# Disabled until #8 provider/privacy/budget approval and #19 evaluation pass.
# Both this browser flag and the server enablement gates must be configured.
VITE_LLM_ENABLED=false
