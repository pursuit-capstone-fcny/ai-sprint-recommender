# Published public catalog origin. No Google credentials belong in frontend config.
VITE_CATALOG_SOURCE=static
VITE_LIBRARY_ORIGIN=
# Only true for isolated fictional catalog previews; prevents usage logging.
VITE_LIBRARY_DEMO=false
# Separate private-usage collector. Production logging stays off pending approval.
VITE_USAGE_ENABLED=false
VITE_USAGE_ENVIRONMENT=
VITE_USAGE_TEST_URL=

# Disabled until #8 provider/privacy/budget approval and #19 evaluation pass.
# Both this browser flag and the server enablement gates must be configured.
VITE_LLM_ENABLED=false

# Staff-reviewed requests. See docs/contribution-requests.md.
VITE_REQUESTS_ENABLED=false
VITE_REQUESTS_CONFIG=
