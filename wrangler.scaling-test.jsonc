{
  "name": "fcny-scaling-local-only",
  "main": "server/scaling-test-worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "LLM_ENABLED": "true",
    "LLM_APPROVALS_RECORDED": "true",
    "LLM_ENVIRONMENT": "production",
    "LLM_QUEUE_ENABLED": "true",
    "LLM_MODEL": "claude-haiku-5-5",
    "LIBRARY_ORIGIN": "https://library.example.test",
    "ANTHROPIC_API_KEY": "fixture-only-never-dispatched",
    "LLM_RATE_KEY": "fixture-only-00000000000000000000000000000000",
    "LLM_MAX_INPUT_TOKENS": "80000",
    "LLM_MAX_OUTPUT_TOKENS": "16384",
    "LLM_REQUESTS_PER_MINUTE": "1000",
    "LLM_CLIENT_REQUESTS_PER_MINUTE": "3",
    "LLM_MAX_CONCURRENCY": "32",
    "LLM_DAILY_MICRODOLLARS": "1000000",
    "LLM_MONTHLY_MICRODOLLARS": "5000000",
    "LLM_INPUT_MICRODOLLARS_PER_MILLION": "100000",
    "LLM_OUTPUT_MICRODOLLARS_PER_MILLION": "500000",
    "USAGE_BUFFER_ENABLED": "true",
    "USAGE_UPSTREAM_URL": "https://script.google.com/macros/s/fixture/exec",
    "USAGE_BATCH_SECRET": "fixture-only-buffer-00000000000000000000000000",
  },
  "durable_objects": {
    "bindings": [
      { "name": "RECOMMENDATION_BUDGET", "class_name": "NativeBudget" },
      { "name": "USAGE_BUFFER", "class_name": "NativeUsageBuffer" },
      { "name": "SYNTHETIC_COLLECTOR", "class_name": "SyntheticCollector" },
    ],
  },
  "migrations": [
    {
      "tag": "local-burst-v1",
      "new_sqlite_classes": [
        "NativeBudget",
        "NativeUsageBuffer",
        "SyntheticCollector",
      ],
    },
  ],
}
