{
  // Deploys the built SPA as a static-asset Worker (no server code).
  "name": "ai-sprint-recommender",
  "compatibility_date": "2026-10-01",
  // Required by Cloudflare Builds' preview command for non-production
  // branches. The block stays empty; assets and compat stay top-level.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
